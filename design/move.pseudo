    OUTPUT "You moved to " + current_room

    IF current_room = "Robot Core" THEN
        IF number of collected items < 6 THEN
            OUTPUT "The security robot caught you. Game over!"
            SET game_over = TRUE
        ELSE
            OUTPUT "You collected all six items and completed the mission. You win!"
            SET game_over = TRUE
        END IF
    END IF

ELSE

