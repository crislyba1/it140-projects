# Project One Get-Item Pseudocode


START get_item

    # TODO 1: Identify the information the get-item process needs.

    SET current_room = player's current room
    SET requested_item = ""
    SET inventory = player's collected items

    # TODO 2: Prompt for and receive the player's get-item command.

    OUTPUT "Which item would you like to collect?"
    INPUT requested_item

    # TODO 3: Validate whether the requested item is available in the current room.

    IF current_room contains requested_item THEN

        # TODO 4: Describe what happens when the item request is valid.

        ADD requested_item to inventory
        REMOVE requested_item from current_room

        OUTPUT "You collected the " + requested_item + "."
        OUTPUT "Your inventory now contains " + inventory

        IF number of items in inventory = 6 THEN
            OUTPUT "You collected all six items! You can now complete your mission."
        END IF

    ELSE

        # TODO 5: Describe what happens when the item request is invalid.

        OUTPUT "That item is not available in this room. Please try again."

    END IF

    # TODO 6: Show how the process returns to or continues the larger gameplay loop.

    OUTPUT "Return to the main game loop."

END get_item


